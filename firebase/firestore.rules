rules_version = '2';

// Principe : le navigateur ne peut JAMAIS écrire de l'argent.
// Toutes les écritures sur users, wallets et transactions passent par les Cloud Functions
// (le SDK Admin ignore ces règles). Le joueur ne fait que lire ses propres données.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function role() { return signedIn() ? request.auth.token.get('role', null) : null; }
    function isStaff() { return role() in ['super', 'finance', 'support', 'trader']; }
    function isFinance() { return role() in ['super', 'finance']; }

    match /users/{uid} {
      allow read: if isSelf(uid) || isStaff();
      allow write: if false;
    }

    match /wallets/{uid} {
      allow read: if isSelf(uid) || isFinance() || role() == 'support';
      allow write: if false;
    }

    match /transactions/{txId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isFinance() || role() == 'support';
      allow write: if false;
    }

    // Paris des jeux (et plus tard du sport) : lecture de ses propres paris uniquement.
    match /bets/{betId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isStaff();
      allow write: if false;
    }

    // Tirages : informations publiques pour tout joueur connecté (numéros tirés, cagnotte, gagnant).
    match /lnDraws/{drawId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /jackpotRounds/{roundId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Matchs et cotes : publics pour les joueurs connectés ; modifiés uniquement par les Cloud Functions.
    match /sportEvents/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /adminLogs/{id} {
      allow read: if role() == 'super';
      allow write: if false;
    }

    match /referralCodes/{code} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
