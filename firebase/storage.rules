rules_version = '2';

// Les pièces d'identité (étape KYC, à venir) seront rangées dans kyc/{uid}/.
// Le joueur peut déposer ses propres fichiers mais pas les relire ; seul le staff les consulte.
service firebase.storage {
  match /b/{bucket}/o {
    match /kyc/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null && request.auth.token.get('role', null) in ['super', 'finance', 'support'];
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
